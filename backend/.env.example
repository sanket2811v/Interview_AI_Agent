# Backend Environment Configuration Example
# Server Port
PORT=5000

# Application Environment (development | production | test)
NODE_ENV=development

# PostgreSQL Connection URL via Prisma
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_ai?schema=public

# Allowed CORS Origin for frontend client
FRONTEND_URL=http://localhost:5173

# Phase 9: Secure Code Execution Engine Configuration
# Supported providers: piston | judge0 | mock
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_API_URL=https://emkc.org/api/v2/piston
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_TIMEOUT_MS=30000
CODE_EXECUTION_MAX_SOURCE_SIZE=50000
CODE_EXECUTION_MAX_CONCURRENT_REQUESTS=3

