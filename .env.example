# InterviewAI - Global Environment Configuration
# Copy this file to individual .env files in backend and frontend as needed.

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/interview_ai?schema=public

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Authentication & JWT Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_at_least_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_at_least_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email (SMTP) Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=secret_password
SMTP_FROM=InterviewAI <no-reply@interviewai.dev>

# Token Expiry Settings
PASSWORD_RESET_EXPIRES_MINUTES=30
EMAIL_VERIFICATION_EXPIRES_HOURS=24

# OpenAI Configuration (Phase 6 AI Job Description Analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=60000
OPENAI_MAX_RETRIES=2
OPENAI_MAX_INPUT_CHARS=30000
OPENAI_BASE_URL=https://api.openai.com/v1

# Secure Code Execution Engine (Phase 9)
CODE_EXECUTION_PROVIDER=piston
CODE_EXECUTION_ENABLED=true
CODE_EXECUTION_API_URL=https://emkc.org/api/v2/piston
CODE_EXECUTION_API_KEY=
CODE_EXECUTION_TIMEOUT_MS=30000

# Frontend Configuration
VITE_API_BASE_URL=/api
VITE_APP_NAME="InterviewAI"
