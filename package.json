{
  "name": "interviewai",
  "version": "1.0.0",
  "description": "InterviewAI - Production-grade AI-powered Interview Preparation Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently --shell powershell.exe --kill-others-on-fail -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"blue.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "start": "npm run start --prefix backend",
    "test": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend",
    "prisma:validate": "npm run prisma:validate --prefix backend",
    "prisma:status": "npm run prisma:status --prefix backend",
    "prisma:deploy": "npm run prisma:deploy --prefix backend",
    "prisma:repair": "node backend/prisma/repair_migrations.js",
    "prisma:resolve": "node backend/prisma/repair_migrations.js",
    "prisma:push": "npm run prisma:push --prefix backend",
    "prisma:migrate": "npm run prisma:migrate --prefix backend",
    "prisma:seed": "npm run prisma:seed --prefix backend",
    "db:seed": "npm run seed --prefix backend",
    "prisma:studio": "npm run prisma:studio --prefix backend",
    "provider:diagnose": "node backend/scripts/diagnose_provider.js"
  },
  "keywords": [
    "interview-ai",
    "react",
    "express",
    "prisma",
    "fullstack"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
